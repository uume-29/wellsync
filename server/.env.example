# WellSync Backend Server Configuration
# Port on which the Express server listens
PORT=5000

# MongoDB Connection URI (e.g., local MongoDB or MongoDB Atlas connection string)
# If local MongoDB is unavailable, server automatically falls back to an embedded in-memory MongoDB instance for development
MONGO_URI=mongodb://127.0.0.1:27017/wellsync

# JWT Signing Secret (Generate a strong 32+ character random string for production)
JWT_SECRET=your_jwt_secret_key_here_replace_in_production

# Frontend Application Client URL (allowed origin for HttpOnly cookie CORS)
CLIENT_URL=http://localhost:5173

# Environment mode: development or production
NODE_ENV=development
